# Production Environment Variables Sample
# Copy this file to .env.prod and fill in the actual values

# === Build-time Variables (PUBLIC_*) ===
# These are injected during Docker build and embedded in the frontend bundle
PUBLIC_CAL_USERNAME=dmitrybond
PUBLIC_CAL_EMBED_LINK=https://cal.com/dmitrybond
PUBLIC_CAL_EVENTS=intro-30m|Intro 30m,tech-90m|Tech 90m,mentoring-60m|Mentoring 60m
PUBLIC_SITE_URL=https://dmitrybond.tech
PUBLIC_ENV=production
PUBLIC_DECAP_CMS_VERSION=3.8.3

# === Runtime Variables (Server-side) ===
# These are used by the server at runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
BASE_URL=https://dmitrybond.tech
SOCKET_PATH=/var/run/website/astro.sock

# === GitHub OAuth Configuration ===
# IMPORTANT: Use SEPARATE GitHub OAuth Apps for Auth.js and Decap CMS!
AUTHJS_GITHUB_CLIENT_ID=your_authjs_github_client_id
AUTHJS_GITHUB_CLIENT_SECRET=your_authjs_github_client_secret
DECAP_GITHUB_CLIENT_ID=your_decap_github_client_id
DECAP_GITHUB_CLIENT_SECRET=your_decap_github_client_secret

# === Auth.js Configuration ===
AUTH_URL=https://dmitrybond.tech
AUTH_TRUST_HOST=true
AUTH_SECRET=your_auth_secret_here

# === Decap CMS Configuration ===
DECAP_GITHUB_REPO=dmitrybond-tech/personal-website-prod
DECAP_GITHUB_BRANCH=main
DECAP_OAUTH_STATE_SECRET=your_decap_oauth_state_secret

# === Admin Authorization ===
ALLOWED_GH_LOGINS=your_github_username
ALLOWED_GH_ORG=your_github_org

# === Cal.com Webhook Configuration ===
CAL_WEBHOOK_SECRET=your_cal_webhook_secret
CAL_DEBUG=0
CAL_DUMP_WEBHOOKS_DIR=var/webhooks
CAL_WEBHOOK_DEV_SKIP_VERIFY=0

# === Git Information ===
GIT_SHA=unknown