---
import { getCollection } from 'astro:content';
import AppShell from '../../../app/layouts/AppShell.astro';

const lang = Astro.url.pathname.split('/')[1];
const { slug } = Astro.params;
// basename — последняя часть, даже если пришло "ru/hello-world"
const base = Array.isArray(slug) ? slug.at(-1) : slug;

const entries = await getCollection('posts', ({ id }) => id.startsWith(`${lang}/`));
const entry = entries.find((e) => e.slug.split('/').pop() === base);

if (!entry) return Astro.redirect(`/${lang}/blog`, 302);

const { Content } = await entry.render();
---

<AppShell title={entry.data.title} variant="blog">
  <article class="blog-post">
    <div class="post-container">
      <nav class="post-nav">
        <a href={`/${lang}/blog`} class="back-link">
          ← {lang === 'ru' ? 'Назад к блогу' : 'Back to blog'}
        </a>
      </nav>
      
      <section class="rounded-2xl border cv-panel shadow-sm">
        <div class="p-5 sm:p-6 lg:p-8">
          <header class="post-header">
            <h1 class="post-title">{entry.data.title}</h1>
            <div class="post-meta">
              <time class="post-date">
                {new Date(entry.data.date).toLocaleDateString(lang === 'ru' ? 'ru-RU' : 'en-US')}
              </time>
              {entry.data.tags && entry.data.tags.length > 0 && (
                <div class="post-tags">
                  {entry.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
            {entry.data.description && (
              <p class="post-description">{entry.data.description}</p>
            )}
          </header>
          
          <div class="post-content">
            <Content />
          </div>
        </div>
      </section>
    </div>
  </article>
</AppShell>

<style>
  .blog-post {
    padding: 2rem 0;
  }
  
  .post-container {
    max-width: var(--cv-content-max-w, 800px);
    margin: 0 auto;
    padding: 0 var(--cv-content-pad-x, 1rem);
  }
  
  .post-nav {
    margin-bottom: 1.5rem;
  }
  
  .back-link {
    color: var(--cv-primary-600);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
  }
  
  .dark .back-link {
    color: var(--cv-primary-400);
  }
  
  .back-link:hover {
    text-decoration: underline;
  }
  
  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--cv-border-hairline, #e5e7eb);
  }
  
  .post-title {
    /* Использует token из Typography: section-title */
    font-size: 2.25rem;
    font-weight: 800; /* font-extrabold */
    color: var(--cv-text);
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  
  @media (min-width: 640px) {
    .post-title {
      font-size: 3rem;
    }
  }
  
  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    color: var(--cv-muted);
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .tag {
    background: var(--cv-surface-2);
    color: var(--cv-text);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
  }
  
  .post-description {
    /* Использует token: paragraph */
    font-size: 1rem;
    line-height: 1.625;
    color: var(--cv-muted);
    font-style: italic;
    margin-bottom: 0;
  }
  
  @media (min-width: 640px) {
    .post-description {
      font-size: 1.125rem;
    }
  }
  
  .post-content {
    /* Использует token: paragraph */
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--cv-text);
  }
  
  @media (min-width: 640px) {
    .post-content {
      font-size: 1rem;
      line-height: 1.625;
    }
  }
  
  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 800; /* font-extrabold */
    color: var(--cv-text);
  }
  
  /* Matching Typography tokens */
  .post-content :global(h1) { font-size: 2rem; }      /* item-title */
  .post-content :global(h2) { font-size: 1.5rem; }    /* section-subtitle */
  .post-content :global(h3) { font-size: 1.25rem; }   /* item-title variant */
  .post-content :global(h4) { font-size: 1.125rem; }
  
  .post-content :global(p) {
    margin-bottom: 1.5rem;
  }
  
  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  
  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }
  
  .post-content :global(blockquote) {
    border-left: 4px solid var(--cv-primary-600);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--cv-muted);
  }
  
  .post-content :global(code) {
    background: var(--cv-surface-2);
    color: var(--cv-text);
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }
  
  .post-content :global(pre) {
    background: #1f2937;
    color: #f9fafb;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  
  .post-content :global(pre code) {
    background: none;
    padding: 0;
  }
  
  .dark .post-content :global(pre) {
    background: #111827;
  }
</style>