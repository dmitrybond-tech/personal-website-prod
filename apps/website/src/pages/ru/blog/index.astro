---
import { getCollection } from 'astro:content';
import AppShell from '../../../app/layouts/AppShell.astro';

const lang = Astro.url.pathname.split('/')[1]; // "en" or "ru"

// фильтруем по локали по id (он содержит префикс каталога)
const all = await getCollection('posts', ({ id, data }) =>
  id.startsWith(`${lang}/`) && data.draft !== true
);

// сортировка
const posts = all.sort((a, b) => +b.data.date - +a.data.date);

// Dev logging for blog post counts and file visibility
if (import.meta.env.DEV) {
  console.log('[BLOG]', lang, 'posts:', posts.length, 'slugs:', posts.map(p => p.slug));
}

// строим ЧИСТЫЕ ссылки: если slug уже содержит "ru/...",
// берём только последнюю часть
const linkFor = (e) => `/${lang}/blog/${e.slug.split('/').pop()}`;

const pageTitle = lang === 'ru' ? 'Блог' : 'Blog';
---

<AppShell title={pageTitle} variant="blog">
  <section class="blog-index">
    <div class="blog-container">
      <div class="posts-list">
        {posts.map((p) => (
          <article class="rounded-2xl border cv-panel shadow-sm">
            <div class="p-5 sm:p-6 lg:p-8">
              <h2 class="post-title">
                <a href={linkFor(p)} class="post-link">{p.data.title}</a>
              </h2>
              {p.data.description && (
                <p class="post-description">{p.data.description}</p>
              )}
              <div class="post-meta">
                <time class="post-date">
                  {new Date(p.data.date).toLocaleDateString(lang === 'ru' ? 'ru-RU' : 'en-US')}
                </time>
                {p.data.tags && p.data.tags.length > 0 && (
                  <div class="post-tags">
                    {p.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</AppShell>

<style>
  .blog-index {
    padding: 2rem 0;
  }
  
  .blog-container {
    max-width: var(--cv-content-max-w, 800px);
    margin: 0 auto;
    padding: 0 var(--cv-content-pad-x, 1rem);
  }
  
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .post-title {
    /* Matching Typography: item-title */
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--cv-text);
    margin-bottom: 0.5rem;
  }
  
  .post-link {
    color: var(--cv-primary-600);
    text-decoration: none;
  }
  
  .dark .post-link {
    color: var(--cv-primary-400);
  }
  
  .post-link:hover {
    text-decoration: underline;
  }
  
  .post-description {
    /* Matching Typography: paragraph */
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--cv-muted);
    margin-bottom: 1rem;
  }
  
  @media (min-width: 640px) {
    .post-description {
      font-size: 1rem;
    }
  }
  
  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
    color: var(--cv-muted);
  }
  
  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .tag {
    background: var(--cv-surface-2);
    color: var(--cv-text);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
  }
</style>
