# Multi-stage build for Astro SSG
FROM node:22.12.0-alpine AS builder

# Install system dependencies for native modules (sharp, canvas, etc.)
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    libc6-compat \
    cairo-dev \
    pango-dev \
    jpeg-dev \
    giflib-dev \
    librsvg-dev \
    pixman-dev

WORKDIR /app

# Copy root package files for workspace setup
COPY package.json package-lock.json ./
COPY apps/website/package.json ./apps/website/

# Install dependencies with fallback
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

# Copy source code and scripts
COPY apps/website/ ./apps/website/
COPY scripts/ ./scripts/

# Build the website using workspace command
RUN npm run --workspace apps/website build

# Production stage with Caddy
FROM caddy:2.8.4-alpine

# Copy built files
COPY --from=builder /app/apps/website/dist /usr/share/caddy

# Copy Caddy configuration
COPY infra/caddy/Caddyfile.ssg.example /etc/caddy/Caddyfile

# Expose ports
EXPOSE 80 443

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1
