# Multi-stage build for Astro SSG
FROM node:22.12.0-alpine AS builder

# Install system dependencies for native modules (sharp, canvas, etc.)
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    libc6-compat \
    cairo-dev \
    pango-dev \
    jpeg-dev \
    giflib-dev \
    librsvg-dev \
    pixman-dev

WORKDIR /app

# Copy root package files for workspace setup
COPY package.json package-lock.json ./
COPY apps/website/package.json ./apps/website/

# Install dependencies with fallback
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

# Copy source code and scripts
COPY apps/website/ ./apps/website/
COPY scripts/ ./scripts/

# Build the website using workspace command
RUN npm run --workspace apps/website build

# ---- Runtime stage: Nginx serving static files ----
FROM nginx:alpine

# Install curl for HTTP healthcheck (kept minimal)
RUN apk add --no-cache curl

# Remove default site so we can provide our own config
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy built static files into standard Nginx web root
COPY --from=builder /app/apps/website/dist /usr/share/nginx/html

# Minimal Nginx configuration with SPA-style routing
COPY infra/nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -fsS http://localhost/ || exit 1
